# Copy file này thành .env.local rồi điền giá trị từ Supabase Dashboard.
#
# VITE_SUPABASE_URL      -> Project Settings > Data API > Project URL
#                           Chỉ lấy phần gốc, KHÔNG kèm /rest/v1/
# VITE_SUPABASE_ANON_KEY -> Project Settings > API Keys > Publishable key (sb_publishable_...)
#                           (dự án cũ dùng hệ legacy thì đây là "anon public" key)
#
# KHÔNG BAO GIỜ dùng Secret key (sb_secret_...) hay service_role key ở đây.
# Mọi biến VITE_* đều bị nhúng thẳng vào bundle JS mà trình duyệt nào cũng đọc được.
# Publishable key công khai là bình thường — bảo vệ dữ liệu là việc của RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Dev mặc định dùng /api và Vite proxy tới Python cổng 8000.
# Khi deploy khác domain, điền URL API đầy đủ, gồm /api.
VITE_API_URL=/api
