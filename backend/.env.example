# SQLite local. Chạy python -m app.init_db để tạo DB và nhập catalog.
DATABASE_URL=sqlite:///./shop.db
# PostgreSQL/Supabase: dùng session pooler hoặc direct connection, không dùng transaction pooler.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only (Project Settings > API Keys > Secret key). Needed for admin user management.
SUPABASE_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Swagger tại /docs: chỉ bật khi chạy local, để trống/false trên production.
ENABLE_API_DOCS=true
# Số đơn "chờ xác nhận" tối đa mỗi khách được giữ cùng lúc (mỗi đơn giữ tồn kho).
MAX_OPEN_ORDERS=5
# Thời gian (giây) cache kết quả xác thực Supabase; đổi role có hiệu lực sau tối đa chừng này.
AUTH_CACHE_SECONDS=60

# Thanh toán QR qua TConnect (https://docs.tconnect.vn/docs/intro/). Để trống = chỉ COD.
# Sandbox: lấy bộ thông tin test công khai trong mục "Sandbox Test Credentials" của tài liệu.
# Production: TConnect cấp base URL và thông tin riêng sau khi test xong. KHÔNG commit giá trị thật.
TCONNECT_BASE_URL=
TCONNECT_PARTNER_CODE=
TCONNECT_USERNAME=
TCONNECT_PASSWORD=
TCONNECT_CLIENT_ID=
TCONNECT_CLIENT_SECRET=
TCONNECT_AES_KEY=
TCONNECT_SERVICE_CODE=
TCONNECT_BINCODE=
TCONNECT_VA=
