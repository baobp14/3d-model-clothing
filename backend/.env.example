# SQLite local. Chạy python -m app.init_db để tạo DB và nhập catalog.
DATABASE_URL=sqlite:///./shop.db
# PostgreSQL/Supabase: dùng session pooler hoặc direct connection, không dùng transaction pooler.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
