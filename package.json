{
  "name": "doan-tot-nghiep-avatar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "avatar:fetch": "python tools/avatar-pipeline/fetch_assets.py",
    "avatar:build": "python tools/avatar-pipeline/build_avatar_glb.py",
    "avatar:verify": "node tools/avatar-pipeline/verify_glb.mjs",
    "avatar:report": "node --experimental-strip-types tools/avatar-pipeline/solve_report.mjs",
    "garment:build": "python tools/garment-pipeline/build_garment_glb.py",
    "garment:report": "node --experimental-strip-types tools/garment-pipeline/fit_report.mjs",
    "prints:build": "node tools/garment-pipeline/build_prints.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
